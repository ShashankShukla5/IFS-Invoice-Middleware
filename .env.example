# Server
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Protect POST /api/ifs/invoices (IFS should send x-api-key or Bearer)
NODE_API_KEY=

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/ifs_einvoice?schema=public
# Set true only for local/dev without Postgres (tests default to in-memory)
USE_IN_MEMORY_REPOSITORY=false

# ---------------------------------------------------------------------------
# IFS Cloud REST / Projection endpoints
# Do NOT invent these — paste the actual URLs from your IFS environment.
# Reference DB views (mapping only): CUST_ORDER_INV_HEAD_UIV_ALL / CUST_ORDER_INV_ITEM_UIV_ALL
# ---------------------------------------------------------------------------
IFS_BASE_URL=
IFS_INVOICE_ENDPOINT=
IFS_CUSTOMER_ENDPOINT=
IFS_CUSTOMER_CONTACT_ENDPOINT=
IFS_CUSTOMER_ADDRESS_ENDPOINT=
IFS_INVOICE_LINES_ENDPOINT=
IFS_EINVOICE_UPDATE_ENDPOINT=
IFS_TIMEOUT_MS=30000

# IFS auth — use either a static token OR client-credentials
IFS_ACCESS_TOKEN=
IFS_AUTH_TOKEN_URL=
IFS_CLIENT_ID=
IFS_CLIENT_SECRET=

# Configurable IFS business-event attribute names
IFS_EVENT_ATTR_COMPANY=company
IFS_EVENT_ATTR_SERIES_ID=seriesId
IFS_EVENT_ATTR_INVOICE_NO=invoiceNo
IFS_EVENT_ATTR_INVOICE_ID=invoiceId

# Optional override of projection field names (JSON). See src/config/index.js defaults.
# IFS_FIELD_MAP_JSON=

# ---------------------------------------------------------------------------
# Nigerian E-Invoicing (Cryptware / NRS)
# ---------------------------------------------------------------------------
EINVOICE_BASE_URL=https://preprod-cryptware.onrender.com
EINVOICE_API_KEY=
EINVOICE_TIMEOUT_MS=30000
EINVOICE_STATUS_ENDPOINT=/invoice/status
EINVOICE_QR_ENDPOINT=/invoice/qr

# ---------------------------------------------------------------------------
# Mapping configuration (business confirmation required for unresolved fields)
# ---------------------------------------------------------------------------
DOCUMENT_IDENTIFIER_STRATEGY=COMPANY_SERIES_INVOICE_NO

# Example: {"STANDARD":"381","CUSTORDINV":"381","CREDIT":"380","DEBIT":"384"}
INVOICE_TYPE_CODE_MAP_JSON=

# Example: {"VAT0":"ZERO_VAT","VAT75":"STANDARD_VAT"}
TAX_CATEGORY_MAP_JSON=

# Temporary defaults ONLY after business confirmation (leave empty to force validation failure)
DEFAULT_TRANSACTION_CATEGORY=
DEFAULT_PRODUCT_CATEGORY=
DEFAULT_BUSINESS_DESCRIPTION=
DEFAULT_HSN_CODE_UNIT=

# Proposed payment status map (confirm with business)
# PAYMENT_STATUS_MAP_JSON={"Printed":"PENDING","PaidPosted":"PAID"}

ELIGIBLE_IFS_STATUSES=Printed,PRINTED
